{
  "expo": {
    "scheme": "stafyapp",
    "name": "stafy-mobile",
    "slug": "stafy-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./src/assets/Logo_Stafy.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/Logo_Stafy.png",
        "backgroundImage": "./src/assets/Logo_Stafy.png",
        "monochromeImage": "./src/assets/Logo_Stafy.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stafy.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./src/assets/Logo_Stafy.png",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/Logo_Stafy.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9ecbe78-5e67-4326-a193-faec421660a0"
      }
    }
  }
}
