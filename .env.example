# ── Backend API ─────────────────────────────────────
# Physical device: the dev machine's LAN IP (the IP Metro prints on `just dev`), NOT 127.0.0.1.
# Emulator / simulator / web build: 127.0.0.1 is fine.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Sentry ──────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=                       # unset → Sentry.init() is skipped
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development    # per-build value comes from eas.json (staging/production); this is the local fallback

# Not EXPO_PUBLIC_-prefixed — build-time only (source-map upload at EAS Build).
# Set as an EAS env var (`eas env:create`), never committed.
# SENTRY_AUTH_TOKEN=
